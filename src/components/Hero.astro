---
import StarField from './StarField.astro';
---

<section class="hero" id="hero">
  <StarField />
  <div class="hero-content container">
    <div class="hero-card">
      <p class="hero-greeting">Hi, I'm</p>
      <h1 class="hero-name">
        <span class="gradient-text">Andrew Brown</span>
      </h1>
      <p class="hero-tagline">
        I build local AI systems, security-hardened infrastructure, and production software.<br />
        <span class="hero-tagline-sub">My long game? Creating autonomous systems resilient enough for deep space.</span>
      </p>
      <div class="hero-actions">
        <a href="/#projects" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          View My Work
        </a>
        <a href="/cv/andrew-brown-cv.html" target="_blank" class="btn btn-outline">
          View CV
        </a>
        <a href="/#contact" class="btn btn-outline">
          Get In Touch
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding-top: var(--nav-height);
  }

  .hero-card {
    position: relative;
    overflow: hidden;
    width: min(100%, 46rem);
    background:
      radial-gradient(circle at top left, rgba(0, 217, 255, 0.08), transparent 34%),
      radial-gradient(circle at bottom right, rgba(255, 157, 61, 0.06), transparent 38%),
      rgba(6, 12, 26, 0.72);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: clamp(2.75rem, 5vw, 4.5rem);
    text-align: center;
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .hero-card::before {
    content: '';
    position: absolute;
    inset: 0 18% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 217, 255, 0.55), rgba(255, 157, 61, 0.4), transparent);
  }

  .hero-greeting {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--cyan);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
    border: 1px solid rgba(0, 217, 255, 0.14);
    border-radius: var(--radius-full);
    background: rgba(0, 217, 255, 0.05);
    opacity: 0;
    animation: fadeUp 0.8s var(--ease-out) 0.2s forwards;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: var(--text-7xl);
    font-weight: 800;
    line-height: 1.05;
    margin-bottom: var(--space-md);
    opacity: 0;
    animation: fadeUp 0.8s var(--ease-out) 0.4s forwards;
  }

  .hero-tagline {
    max-width: 38rem;
    margin-inline: auto;
    font-size: clamp(1.05rem, 1.8vw, 1.28rem);
    color: var(--text-primary);
    line-height: 1.45;
    margin-bottom: var(--space-xl);
    opacity: 0;
    animation: fadeUp 0.8s var(--ease-out) 0.6s forwards;
  }

  .hero-tagline-sub {
    display: block;
    max-width: 34rem;
    margin: 0.625rem auto 0;
    color: var(--text-secondary);
    font-size: var(--text-base);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 0.8s var(--ease-out) 0.8s forwards;
  }

  .hero-actions .btn {
    min-height: 2.75rem;
    padding-inline: 1.35rem;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero-card {
      width: 100%;
      padding: var(--space-2xl) var(--space-lg);
    }

    .hero-name {
      font-size: var(--text-5xl);
    }

    .hero-tagline {
      font-size: var(--text-lg);
      line-height: 1.5;
    }

    .hero-tagline-sub {
      font-size: var(--text-base);
    }
  }
</style>
