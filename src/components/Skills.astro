---

<section class="section skills" id="skills">
  <div class="container">
    <div class="reveal">
      <span class="section-label">Skills & Tools</span>
      <h2 class="section-title">What I work with</h2>
      <div class="tier-legend">
        <span class="tier-legend-label">depth:</span>
        <span class="pill">proficient</span>
        <span class="pill pill--neutral">familiar</span>
        <span class="pill pill--neutral pill--tier-light">light</span>
        <span class="pill pill--neutral pill--tier-conceptual">conceptual</span>
      </div>
    </div>
    <div class="skills-panel card reveal-stagger">
      {categories.map(cat => (
        <section class="skill-section">
          <div class="skill-header">
            <svg
              class="skill-cat-icon"
              width="18" height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <Fragment set:html={categoryIcons[cat.name]} />
            </svg>
            <h3 class="skill-name">{cat.name}</h3>
          </div>
          <div class="skill-pills">
            {cat.items.map(item => {
              const name = getSkillName(item);
              const pillClass = getPillClass(item);
              return (
                <span class={pillClass}>
                  {iconMap[name] && (
                    <svg
                      width="12" height="12"
                      viewBox="0 0 24 24"
                      fill={`#${iconMap[name].hex}`}
                      aria-hidden="true"
                      class="pill-icon"
                    >
                      <path d={iconMap[name].path} />
                    </svg>
                  )}
                  {name}
                </span>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-panel {
    position: relative;
    overflow: hidden;
    padding: 0;
  }

  .skills-panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--amber));
    opacity: 0.55;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .skill-section {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--border);
    transition: background 0.25s var(--ease-out);
  }

  .skill-section:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .skill-section:last-child {
    border-bottom: 0;
  }

  .skill-header {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding-top: 0.125rem;
  }

  .skill-cat-icon {
    color: var(--cyan);
    flex-shrink: 0;
    opacity: 0.85;
  }

  .skill-name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.01em;
  }

  .skill-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    min-width: 0;
  }

  .pill-icon {
    display: inline-block;
    vertical-align: middle;
    margin-right: 3px;
    flex-shrink: 0;
    opacity: 0.75;
  }

  .pill {
    display: inline-flex;
    align-items: center;
  }

  /* Proficiency tier modifiers */
  .pill--tier-light {
    opacity: 0.5;
  }

  .pill--tier-conceptual {
    background: transparent !important;
    border-style: dashed;
    opacity: 0.35;
  }

  /* Tier legend strip */
  .tier-legend {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .tier-legend-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-right: 0.125rem;
  }

  @media (max-width: 768px) {
    .skill-section {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding: var(--space-lg);
    }
  }
</style>
