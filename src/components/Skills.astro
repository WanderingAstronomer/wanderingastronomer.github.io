---
import {
  siPython, siHtml5, siJavascript, siSvelte, siDocker, siDebian,
  siGit, siWireguard, siGrafana, siPihole, siQuarkus, siTailwindcss,
  siVite, siUptimekuma, siPagerduty, siNvidia, siWireshark, siGraylog,
  siUbiquiti, siLinux,
} from 'simple-icons';

type TierLevel = 'proficient' | 'familiar' | 'light' | 'conceptual';
type SkillItem = string | { name: string; tier: TierLevel };
interface SkillCategory { name: string; items: SkillItem[] }

const tiered = (name: string, tier: TierLevel): SkillItem => ({ name, tier });
const getSkillName = (item: SkillItem) => typeof item === 'string' ? item : item.name;
const getSkillTier = (item: SkillItem) => typeof item === 'string' ? null : item.tier;
const getPillClass = (item: SkillItem) => {
  const tier = getSkillTier(item);

  if (tier === 'proficient') return 'pill';
  if (tier === 'light') return 'pill pill--neutral pill--tier-light';
  if (tier === 'conceptual') return 'pill pill--neutral pill--tier-conceptual';
  return 'pill pill--neutral';
};

// Brand icon paths + official hex colors for pill labels
const iconMap: Record<string, { path: string; hex: string }> = {
