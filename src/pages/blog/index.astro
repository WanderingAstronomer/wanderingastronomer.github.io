---
import Layout from '../../layouts/Base.astro';

const substackUrl = 'https://wanderingastronomer.substack.com/';
---

<Layout title="Writing — Andrew Brown" description="Andrew Brown's writing now lives on Substack.">
  <section class="redirect-page container">
    <div class="redirect-card">
      <span class="section-label">Writing</span>
      <h1>Writing moved to Substack.</h1>
      <p>
        The on-site blog is retired. New writing lives at
        <a href={substackUrl} target="_blank" rel="noopener noreferrer">wanderingastronomer.substack.com</a>.
      </p>
      <a href={substackUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">Open Substack</a>
    </div>
  </section>

  <script is:inline define:vars={{ substackUrl }}>
    window.location.replace(substackUrl);
  </script>
</Layout>

<style>
  .redirect-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-4xl);
  }

  .redirect-card {
    max-width: 42rem;
    padding: var(--space-2xl);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: rgba(6, 12, 26, 0.72);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    text-align: center;
  }

  .redirect-card h1 {
    margin-bottom: var(--space-md);
  }

  .redirect-card p {
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .redirect-card a:not(.btn) {
    color: var(--cyan);
  }
</style>
